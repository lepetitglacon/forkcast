# HTTP port
PORT=3000
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/forkcast
# Secret used to sign web JWTs (change it!)
JWT_SECRET=change-me-please
# JWT lifetime
JWT_EXPIRES_IN=7d
# Public URL of the API (used for OAuth metadata and MCP resource URL)
PUBLIC_URL=http://localhost:3000
# Public URL of the web app (CORS + OAuth consent redirect)
WEB_URL=http://localhost:5173
# Comma-separated extra CORS origins (optional)
CORS_ORIGINS=
# Debounce (ms) before persisting a document to MongoDB
COLLAB_DEBOUNCE=2000
# MCP rate limit: requests per minute per token
MCP_RATE_LIMIT=120
