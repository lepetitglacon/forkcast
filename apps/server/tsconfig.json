{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": false,
    "noEmit": false,
    "declaration": false,
    "incremental": false,
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "src",
    "test"
  ]
}
