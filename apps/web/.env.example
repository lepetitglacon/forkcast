# Base URL of the API (empty = same origin, proxied by Vite in dev)
VITE_API_URL=
# WebSocket URL of the collaboration endpoint (empty = derived from the page origin + /collab)
VITE_WS_URL=
# "Soutenir sur Ko-fi" link of the settings menu (default https://ko-fi.com/)
VITE_KOFI_URL=
# "Code source" link of the settings menu (hidden when empty)
VITE_REPO_URL=
